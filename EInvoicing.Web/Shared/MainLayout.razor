@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Color="Color.Dark">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
            <i class="fa-solid fa-file-invoice text-info mr-2"></i> JDE E-Invoicing Portal
        </MudText>
        <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-4" Variant="Variant.Outlined">
            Bahrain E-Invoice Compliant
        </MudChip>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4 bg-light">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1E40AF",
            Secondary = "#0F766E",
            AppbarBackground = "#0F172A",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1E293B",
            TextPrimary = "#0F172A",
            ActionDefault = "#475569"
        }
    };
}
